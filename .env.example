# Copy to .env.local at the repository root. Never commit real credentials.
# Leave unset for local SQLite. A configured URL must connect successfully;
# connection failures never silently fall back to a different database.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# Direct URL for `python server/migrate.py`; use the same database/branch.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
