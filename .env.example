# Copy to .env.local at the repository root. Never commit real credentials.
# Required: the server intentionally fails fast instead of using a local database.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# Direct URL for `python server/migrate.py`; use the same database/branch.
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
